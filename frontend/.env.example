# BountyJudge frontend configuration
# Copy to .env and fill in the deployed contract address.

# Deployed BountyJudge contract address on Bradbury testnet (0x...).
# Get it after deploying contracts/BountyJudge.py (see ../README.md).
VITE_CONTRACT_ADDRESS=

# Network: "bradbury" (default, testnet) or "studio" (local GenLayer Studio).
VITE_GENLAYER_NETWORK=bradbury

# Optional RPC override (defaults to the chain's public RPC).
# VITE_GENLAYER_RPC_URL=https://rpc-bradbury.genlayer.com
